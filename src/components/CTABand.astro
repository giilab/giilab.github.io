---
import Container from "./ui/Container.astro";
import ButtonLink from "./ui/ButtonLink.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import { SITE } from "@/lib/site";

// Default slot overrides the title (it may carry a serif accent span).
type Props = { body?: string; cta?: string };
const {
  body = "One free 30-minute call, and an honest answer on what AI can and cannot do about it.",
  cta = "Discuss your project",
} = Astro.props;
---

<section class="relative z-[2] py-[clamp(56px,7vw,88px)]">
  <Container>
    <div
      class="overflow-hidden rounded-[28px] border border-line bg-[linear-gradient(180deg,var(--bg-card),transparent)] px-[clamp(26px,4vw,56px)] py-[clamp(40px,6vw,76px)] text-center"
    >
      <div class="flex justify-center"><Eyebrow>Next step</Eyebrow></div>
      <h2 class="t-h2 mx-auto mt-[22px] max-w-[20ch]">
        <slot>Tell us what your <span class="serif accent">business needs.</span></slot>
      </h2>
      <p class="t-lead mx-auto mt-5 text-center">{body}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3.5">
        <ButtonLink href="/contact/">{cta}</ButtonLink>
      </div>
      <p class="mt-5 text-[0.9rem] text-muted">
        Or email us at{" "}
        <a href={`mailto:${SITE.email}`} class="underline-offset-4 hover:text-accent-ink hover:underline">{SITE.email}</a>
      </p>
    </div>
  </Container>
</section>
