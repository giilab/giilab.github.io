---
// Icon follows the theme through the `dark:` variant (wired to data-theme), so only
// the click handler and the label need script.
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch to dark theme"
  class="grid h-9 w-9 place-items-center rounded-full border border-line-strong text-text transition-colors duration-300 hover:border-accent-ink hover:text-accent-ink"
>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path class="dark:hidden" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    <g class="hidden dark:inline">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const label = () =>
    button.setAttribute("aria-label", `Switch to ${root.dataset.theme === "dark" ? "light" : "dark"} theme`);
  label();
  button.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    label();
    try {
      localStorage.setItem("giilab-theme", next);
    } catch {
      /* private mode — the choice just will not persist */
    }
  });
</script>
