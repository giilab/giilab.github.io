---
/** Hairline card. No shadow — depth comes from the border and the lift on hover. */
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<div
  class={`flex flex-col gap-3 rounded-[var(--radius-brand)] border border-line bg-surface px-7 py-[26px] transition-[transform,border-color] duration-500 ease-[var(--ease-brand)] hover:-translate-y-1.5 hover:border-line-strong ${className}`}
>
  <slot />
</div>
