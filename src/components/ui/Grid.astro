---
type Props = { cols?: 2 | 3 | 4; class?: string };
const { cols = 3, class: className = "" } = Astro.props;
const map = { 2: "sm:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3", 4: "sm:grid-cols-2 lg:grid-cols-4" }[cols];
---

<div class={`grid grid-cols-1 gap-5 ${map} ${className}`}><slot /></div>
