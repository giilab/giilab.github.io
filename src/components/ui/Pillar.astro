---
/** Numbered feature panel with the subtle top-down fade. */
type Props = { index: string; title: string };
const { index, title } = Astro.props;
---

<div
  class="flex flex-col gap-3 overflow-hidden rounded-[var(--radius-brand)] border border-line bg-[linear-gradient(180deg,var(--bg-card),transparent)] p-[clamp(26px,3vw,38px)] transition-[transform,border-color] duration-500 ease-[var(--ease-brand)] hover:-translate-y-1.5 hover:border-line-strong"
>
  <span class="text-[0.85rem] tracking-[0.01em] text-accent-ink">{index}</span>
  <h3 class="t-h3">{title}</h3>
  <slot />
</div>
