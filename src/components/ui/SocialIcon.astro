---
// Brand glyphs (Simple Icons, 24x24) live in public/icons/ as cached files rather
// than ~2.5 KB of inline path data on every page; masked so they take currentColor.
type Props = { name: "linkedin" | "whatsapp" | "github"; size?: number };
const { name, size = 20 } = Astro.props;
const mask = `url(/icons/${name}.svg) center / contain no-repeat`;
---

<span
  aria-hidden="true"
  class="inline-block shrink-0 bg-current"
  style={`width:${size}px;height:${size}px;mask:${mask};-webkit-mask:${mask}`}></span>
