---
import MarkGradient from "../MarkGradient.astro";
import { uid } from "@/lib/ids";

/**
 * Contact hero, built like the homepage HeroMark: on an 8s loop the "AI" outline
 * draws itself, fills with the brand gradient, holds, then unwinds, floating
 * throughout. Reduced motion shows it filled and still.
 */
// Bold "AI" letterforms in a 400-unit scene: A (with its triangular counter cut out, evenodd) and I.
const AI_PATH = "M130 50H190L300 350H240L229 320H91L80 350H20Z M160 132L107.5 275H212.5Z M330 50H385V350H330Z";
const g = uid("ai");
---

<div class="relative">
  <div class="hero-mark-glow"></div>
  <svg viewBox="0 0 400 400" class="hero-mark-float relative w-full" focusable="false">
    <defs><MarkGradient id={g} x1={20} y1={50} x2={385} y2={350} /></defs>
    <path d={AI_PATH} fill-rule="evenodd" fill={`url(#${g})`} class="hero-mark-fill" />
    <path d={AI_PATH} fill="none" stroke={`url(#${g})`} stroke-width="3" pathLength="1" class="hero-mark-draw" />
  </svg>
</div>
