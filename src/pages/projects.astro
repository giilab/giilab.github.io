---
import Base from "@/layouts/Base.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Card from "@/components/ui/Card.astro";
import Grid from "@/components/ui/Grid.astro";
import Pill from "@/components/ui/Pill.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import TokenStreamVisual from "@/components/visuals/TokenStreamVisual.astro";
import CTABand from "@/components/CTABand.astro";
import { SITE, CASE_STUDIES, INDUSTRIES, pageMeta } from "@/lib/site";

const meta = pageMeta(
  "/projects/",
  "AI Engineering Projects & Portfolio",
  "The Giilab engineering portfolio: software projects, technical demonstrations and how we build AI applications in practice.",
);

// Stroke icons drawn on a 24px grid, paths inlined to avoid an icon dependency.
const CATEGORIES = [
  {
    name: "Software Engineering",
    body: "Frontend applications, backend platforms, APIs, cloud applications and integrations.",
    icon: "m8 7-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16",
  },
  {
    name: "AI Engineering",
    body: "RAG, intelligent applications, AI agents and automation.",
    icon: "M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2ZM9.5 15l1.75-6h1.5L14.5 15M10.1 13h3.8M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3",
  },
  {
    name: "Data & Cloud Engineering",
    body: "Data pipelines, infrastructure and operational systems.",
    icon: "M7 13.5H6.5a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 16.6 5a4 4 0 0 1 2.9 5.5M10 14.5c0-1.1 2.24-2 5-2s5 .9 5 2-2.24 2-5 2-5-.9-5-2ZM10 14.5v5c0 1.1 2.24 2 5 2s5-.9 5-2v-5M10 17c0 1.1 2.24 2 5 2s5-.9 5-2",
  },
];
---

<Base meta={meta}>
  <PageHero
    eyebrow="Projects"
    lead="Our work spans frontend applications, backend platforms, cloud-native applications, data engineering, software integrations and intelligent automation. Some client engagements are confidential. We share the technical work we can make public and discuss relevant delivery experience directly."
  >
    <TokenStreamVisual slot="visual" />
    <Fragment slot="title">AI and software <span class="serif accent">projects that work.</span></Fragment>
  </PageHero>

  {CASE_STUDIES.length > 0 && (
    <Section>
      <Container>
        <Grid class="lg:grid-cols-2">
          {CASE_STUDIES.map((c) => (
            <Card class="gap-3.5">
              <span class="text-[0.7rem] font-medium uppercase tracking-[0.14em] text-faint">
                {c.industry}
              </span>
              <h2 class="text-[1.25rem] font-semibold">{c.client}</h2>
              <p class="text-[0.95rem] text-muted">{c.problem}</p>
              <p class="text-[0.95rem] text-muted">{c.work}</p>
              {c.outcome && <p class="text-[0.95rem] font-medium text-accent-ink">{c.outcome}</p>}
              <div class="mt-1 flex flex-wrap gap-2">
                {c.stack.map((t) => <Pill>{t}</Pill>)}
              </div>
            </Card>
          ))}
        </Grid>
      </Container>
    </Section>
  )}

  <Section>
    <Container>
      <div class="grid gap-5 lg:grid-cols-2">
        <Card class="gap-3">
          <h2 class="text-[1.1rem] font-semibold">Founder&rsquo;s Portfolio</h2>
          <p class="text-[0.95rem] text-muted">
            {SITE.founder.name}&rsquo;s portfolio covers 12+ years of backend, cloud and data
            engineering: the production experience {SITE.name} is built on.
          </p>
          <a
            href={SITE.portfolio}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto w-fit text-[0.95rem] text-accent-ink underline-offset-4 hover:underline"
          >
            View the portfolio &rarr;
          </a>
        </Card>
        <Card class="gap-3">
          <h2 class="text-[1.1rem] font-semibold">Client Engagements</h2>
          <p class="text-[0.95rem] text-muted">
            Client work is shared according to confidentiality and disclosure agreements.
          </p>
          <p class="text-[0.95rem] text-muted">
            Where permitted, we can discuss relevant experience, architecture decisions
            and delivery approaches during an initial conversation.
          </p>
        </Card>
      </div>

      <div class="mt-12">
        <h2 class="text-[clamp(1.4rem,2.8vw,2rem)] font-bold">What we build</h2>
        <Grid class="mt-6 lg:grid-cols-3">
          {CATEGORIES.map((c) => (
            <Card class="gap-2">
              <div class="flex items-center gap-3">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent-ink">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={c.icon} />
                  </svg>
                </span>
                <h3 class="text-[1.05rem] font-semibold">{c.name}</h3>
              </div>
              <p class="text-[0.95rem] text-muted">{c.body}</p>
            </Card>
          ))}
        </Grid>
      </div>

      <div class="mt-12 max-w-[62ch]">
        <h2 class="text-[clamp(1.4rem,2.8vw,2rem)] font-bold">How we demonstrate value</h2>
        <p class="mt-3 text-[0.98rem] text-muted">
          Rather than relying on generic performance claims, we prefer evidence from real
          implementations. Where a project allows publication, we document:
        </p>
        <ul class="mt-3 grid list-disc gap-1.5 pl-5 text-[0.98rem] text-muted">
          <li>The business or technical challenge.</li>
          <li>The solution and architecture.</li>
          <li>The implementation approach.</li>
          <li>The evaluation criteria and measured outcomes.</li>
          <li>The technology stack.</li>
        </ul>
        <p class="mt-3 text-[0.98rem] text-muted">
          If we cannot back an outcome with evidence, we leave it out rather than estimate
          it. Until a client agrees to publish, we are happy to walk you through comparable
          work on a call.
        </p>
      </div>

      <div class="mt-12">
        <h2 class="text-[clamp(1.4rem,2.8vw,2rem)] font-bold">
          Sectors the team has delivered in
        </h2>
        <p class="mt-3 max-w-[60ch] text-[0.98rem] text-muted">
          Production systems, built and run. Specific clients and outcomes are
          available on request rather than published here.
        </p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {INDUSTRIES.map((i) => <Pill>{i.name}</Pill>)}
        </div>
        <div class="mt-9">
          <ButtonLink href="/contact/" variant="ghost">Ask for references</ButtonLink>
        </div>
      </div>
    </Container>
  </Section>

  <CTABand
    body="A focused proof of concept can help evaluate feasibility before committing to a larger implementation."
    cta="Discuss a Proof of Concept"
  >
    Start with your own <span class="serif accent">challenge.</span>
  </CTABand>
</Base>
