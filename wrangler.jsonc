// Cloudflare Workers static assets: serves the `astro build` output in ./dist.
{
  "name": "giilab",
  "compatibility_date": "2025-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages go through worker.js for the CSP nonce; hashed assets skip it.
    "run_worker_first": ["/*", "!/_astro/*"]
  }
}
